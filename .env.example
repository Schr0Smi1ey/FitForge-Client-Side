# Copy to .env.local and fill in real values.
# .env.local is gitignored via the "*.local" rule — never commit secrets.
# Vite only exposes variables prefixed with VITE_, and everything here is
# embedded into the client bundle, so treat all of it as public.

# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_apiKey=
VITE_authDomain=
VITE_projectId=
VITE_storageBucket=
VITE_messagingSenderId=
VITE_appId=

# imgbb API key, used to host user-uploaded images (https://api.imgbb.com)
VITE_IMAGE_HOSTING_KEY=

# Stripe PUBLISHABLE key (pk_test_... / pk_live_...).
# Never put the secret key here — this file ships to the browser.
VITE_Payment_Gateway_PK=
